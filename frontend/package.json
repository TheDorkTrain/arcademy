{
  "name": "gamehub-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.2",
    "loglevel": "^1.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.8.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-unused-vars": ["warn", {
        "varsIgnorePattern": "^(navigate|email|setEmail|showAd|handleCloseAd|useRef|showDrawConfirm|setShowDrawConfirm|challengeAvailable|setChallengeAvailable|getRandomFloorPosition|useEffect|useState|roundResult|joinRoom|deck|setDeck|useCallback|useNavigate|token|width|height|index|user|onLogout|drawCount|req|res)$"
      }],
      "react-hooks/exhaustive-deps": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "http-proxy-middleware": "^3.0.5"
  }
}
